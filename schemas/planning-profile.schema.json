{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pathway-atlas.example/schemas/planning-profile.schema.json",
  "title": "PathwayAtlas anonymous planning profile input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gender", "province", "city", "high_school", "grade", "exam_year", "class_level", "subject_mode", "subject_group", "secondary_subjects", "score_basis", "rank_observations", "best_rank", "usual_rank", "preparation_assets", "constraints", "priorities", "target_school_reasons", "target_major_reasons", "pathway_preferences", "eligibility_facts"],
  "properties": {
    "schema_version": {"const": "3.0"}, "gender": {"enum": ["男", "女", "不便回答"]}, "province": {"$ref": "#/$defs/publicText"}, "city": {"$ref": "#/$defs/nullablePublicText"}, "high_school": {"$ref": "#/$defs/nullablePublicText"}, "grade": {"enum": ["高一", "高二", "高三"]}, "exam_year": {"type": "integer", "minimum": 2000, "maximum": 2100}, "class_level": {"$ref": "#/$defs/nullablePublicText"}, "subject_mode": {"enum": ["3+1+2", "3+3"]}, "subject_group": {"$ref": "#/$defs/publicText"},
    "secondary_subjects": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/publicText"}}, "score_basis": {"oneOf": [{"type": "null"}, {"enum": ["原始分", "赋分", "原始分与赋分", "不确定"]}]}, "rank_observations": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/rankObservation"}}, "best_rank": {"$ref": "#/$defs/nullablePositiveInteger"}, "usual_rank": {"$ref": "#/$defs/nullablePositiveInteger"}, "preparation_assets": {"$ref": "#/$defs/preparationAssets"}, "constraints": {"$ref": "#/$defs/planningConstraints"}, "priorities": {"$ref": "#/$defs/decisionPriorities"}, "target_school_reasons": {"$ref": "#/$defs/publicTextArray"}, "target_major_reasons": {"$ref": "#/$defs/publicTextArray"}, "pathway_preferences": {"$ref": "#/$defs/pathwayPreferences"}, "eligibility_facts": {"$ref": "#/$defs/publicTextArray"}
  },
  "$defs": {
    "publicText": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S(?:.*\\S)?$"}, "nullablePublicText": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/publicText"}]}, "publicTextArray": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/publicText"}}, "nullablePositiveInteger": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]}, "nullableScore": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 1500}]}, "readiness": {"enum": ["unknown", "not_ready", "developing", "ready"]},
    "preparationAssets": {"type": "object", "additionalProperties": false, "required": ["subject_strengths", "awards", "research_experiences", "activities", "english_readiness", "interview_readiness", "physical_readiness"], "properties": {"subject_strengths": {"$ref": "#/$defs/publicTextArray"}, "awards": {"$ref": "#/$defs/publicTextArray"}, "research_experiences": {"$ref": "#/$defs/publicTextArray"}, "activities": {"$ref": "#/$defs/publicTextArray"}, "english_readiness": {"$ref": "#/$defs/readiness"}, "interview_readiness": {"$ref": "#/$defs/readiness"}, "physical_readiness": {"$ref": "#/$defs/readiness"}}},
    "planningConstraints": {"type": "object", "additionalProperties": false, "required": ["excluded_regions", "budget_level", "institution_types", "service_commitment", "adjustment_preference", "risk_preference", "health_constraints"], "properties": {"excluded_regions": {"$ref": "#/$defs/publicTextArray"}, "budget_level": {"enum": ["unknown", "limited", "moderate", "flexible"]}, "institution_types": {"type": "array", "uniqueItems": true, "items": {"enum": ["public", "private", "cooperative"]}}, "service_commitment": {"enum": ["unknown", "accept", "consider", "reject"]}, "adjustment_preference": {"enum": ["unknown", "accept", "consider", "reject"]}, "risk_preference": {"enum": ["unknown", "conservative", "balanced", "aggressive"]}, "health_constraints": {"$ref": "#/$defs/publicTextArray"}}},
    "decisionPriorities": {"type": "object", "additionalProperties": false, "required": ["school_vs_major", "target_schools", "target_majors", "target_regions", "future_plan", "concerns", "desired_outcomes"], "properties": {"school_vs_major": {"enum": ["unknown", "school_first", "major_first", "balanced"]}, "target_schools": {"$ref": "#/$defs/publicTextArray"}, "target_majors": {"$ref": "#/$defs/publicTextArray"}, "target_regions": {"$ref": "#/$defs/publicTextArray"}, "future_plan": {"enum": ["unknown", "employment", "postgraduate", "public_service", "overseas", "entrepreneurship"]}, "concerns": {"$ref": "#/$defs/publicTextArray"}, "desired_outcomes": {"$ref": "#/$defs/publicTextArray"}}},
    "pathwayPreferences": {"type": "object", "additionalProperties": false, "required": ["strong_foundation", "comprehensive_evaluation", "special_program", "service_oriented", "uniformed_service", "cross_border", "arts_sports"], "properties": {"strong_foundation": {"$ref": "#/$defs/pathwayPreference"}, "comprehensive_evaluation": {"$ref": "#/$defs/pathwayPreference"}, "special_program": {"$ref": "#/$defs/pathwayPreference"}, "service_oriented": {"$ref": "#/$defs/pathwayPreference"}, "uniformed_service": {"$ref": "#/$defs/pathwayPreference"}, "cross_border": {"$ref": "#/$defs/pathwayPreference"}, "arts_sports": {"$ref": "#/$defs/pathwayPreference"}}}, "pathwayPreference": {"enum": ["unknown", "interested", "not_interested", "not_applicable"]},
    "rankObservation": {"type": "object", "additionalProperties": false, "required": ["exam_date", "scope", "score", "max_score", "rank", "cohort_size"], "properties": {"exam_date": {"type": "string", "format": "date"}, "scope": {"enum": ["school", "city_joint", "province_joint", "province_official"]}, "score": {"$ref": "#/$defs/nullableScore"}, "max_score": {"$ref": "#/$defs/nullablePositiveInteger"}, "rank": {"$ref": "#/$defs/nullablePositiveInteger"}, "cohort_size": {"$ref": "#/$defs/nullablePositiveInteger"}, "subject_group": {"$ref": "#/$defs/publicText"}, "high_school": {"$ref": "#/$defs/nullablePublicText"}, "class_level": {"$ref": "#/$defs/nullablePublicText"}, "source": {"enum": ["user_reported", "school_report", "joint_exam_report", "official_score"]}}}
  }
}
