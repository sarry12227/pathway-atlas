{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/shengxue-skill/schemas/province.schema.json",
  "title": "Province dataset metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "province",
    "mode",
    "primary_subjects",
    "secondary_subjects",
    "score_scale",
    "schema_version"
  ],
  "properties": {
    "province": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": ["3+1+2", "3+3"]
    },
    "primary_subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!.*[\\r\\n])\\S(?:[^\\r\\n]*\\S)?$"
      }
    },
    "secondary_subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!.*[\\r\\n])\\S(?:[^\\r\\n]*\\S)?$"
      }
    },
    "score_scale": {
      "type": "number",
      "minimum": 100,
      "maximum": 1000
    },
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "3+1+2"}}},
      "then": {"properties": {"secondary_subjects": {"minItems": 2}}}
    },
    {
      "if": {"properties": {"mode": {"const": "3+3"}}},
      "then": {
        "anyOf": [
          {"properties": {"primary_subjects": {"minItems": 2}}},
          {"properties": {"secondary_subjects": {"minItems": 2}}}
        ]
      }
    }
  ]
}
