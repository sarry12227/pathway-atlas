{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pathway-atlas/schemas/query-plan.schema.json",
  "title": "Deterministic research query plan",
  "$comment": "Structure is validated here; trusted-catalog identity, per-task ID, discovery context, target, availability, candidate, tier, and extraction semantics also require the declared runtime validator.",
  "x-semantic-validator": {
    "locator": "scripts.query_plan.validate_query_plan_payload",
    "flat_locator": "query_plan.validate_query_plan_payload",
    "checks": [
      "task_id_digest",
      "task_context",
      "catalog_discovery_context",
      "trusted_catalog_identity",
      "catalog_digest_binding",
      "decision_policy_binding",
      "research_year_binding",
      "structured_target",
      "explicit_four_year_window",
      "strict_year_order",
      "availability_expectation",
      "candidate_limit",
      "retry_stop_bounds",
      "source_tiers",
      "source_policy_reference",
      "pathway_trace",
      "pathway_task_binding",
      "extraction_fields"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "province",
    "mode",
    "exam_year",
    "research_year",
    "subject_group",
    "authority_name",
    "official_roots",
    "catalog_verified_at",
    "catalog_digest",
    "decision_policy_id",
    "decision_policy_digest",
    "decision_basis_id",
    "decision_source_id",
    "decision_source_version",
    "source_policy_id",
    "source_policy_version",
    "pathway_trace",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "province": {
      "$ref": "#/$defs/publicText"
    },
    "mode": {"enum": ["3+1+2", "3+3"]},
    "exam_year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100
    },
    "research_year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100,
      "description": "Trusted UTC research year Y; independent from the student's expected exam year."
    },
    "subject_group": {
      "$ref": "#/$defs/publicText"
    },
    "authority_name": {
      "$ref": "#/$defs/publicText"
    },
    "official_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/officialRoot"}
    },
    "catalog_verified_at": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "catalog_digest": {"$ref": "#/$defs/sha256"},
    "decision_policy_id": {"$ref": "#/$defs/safeId"},
    "decision_policy_digest": {"$ref": "#/$defs/sha256"},
    "decision_basis_id": {"$ref": "#/$defs/safeId"},
    "decision_source_id": {"$ref": "#/$defs/safeId"},
    "decision_source_version": {"$ref": "#/$defs/version"},
    "source_policy_id": {"const": "pathway-atlas-source-policy"},
    "source_policy_version": {"const": "1.0"},
    "pathway_trace": {
      "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true,
      "items": {"$ref": "#/$defs/pathwayTrace"}
    },
    "tasks": {
      "type": "array",
      "minItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/queryTask"
      }
    }
  },
  "$defs": {
    "publicText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001F\\u007F])[\\s\\S]+$"
    },
    "safeField": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "safeId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
    "pathwayTrace": {
      "type": "object", "additionalProperties": false,
      "required": ["pathway_id", "preference", "decision", "reason_code"],
      "properties": {
        "pathway_id": {"enum": ["strong_foundation", "comprehensive_evaluation", "special_program", "service_oriented", "uniformed_service", "cross_border", "arts_sports"]},
        "preference": {"enum": ["unknown", "interested", "not_interested", "not_applicable"]},
        "decision": {"enum": ["include", "discover", "exclude"]},
        "reason_code": {"enum": ["profile_interested", "preference_unknown_requires_discovery", "profile_not_interested", "profile_not_applicable", "service_commitment_rejected", "legacy_private_compatibility"]}
      }
    },
    "officialRoot": {
      "type": "string",
      "pattern": "^https://[^/?#\\s]+(?:/[^?#\\s]*)?$"
    },
    "queryTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "kind",
        "province",
        "year",
        "subject_group",
        "authority_name",
        "official_roots",
        "target_name",
        "query_variants",
        "preferred_source_tiers",
        "max_candidates",
        "freshness_rule",
        "required_extraction_fields",
        "availability_expectation"
        ,"max_network_retries"
        ,"stop_conditions"
        ,"unavailable_reasons"
        ,"source_policy_id"
        ,"source_policy_version"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "province_policy",
            "score_table",
            "batch_admission",
            "joy_report",
            "enrollment_plan",
            "admission_charter",
            "tuition_fee",
            "subject_requirement",
            "strong_foundation",
            "comprehensive_evaluation",
            "hk_macao_admission",
            "special_pathway"
          ]
        },
        "province": {
          "$ref": "#/$defs/publicText"
        },
        "year": {
          "type": "integer",
          "minimum": 1998,
          "maximum": 2100
        },
        "subject_group": {
          "$ref": "#/$defs/publicText"
        },
        "authority_name": {
          "$ref": "#/$defs/publicText"
        },
        "official_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/officialRoot"}
        },
        "target_name": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001F\\u007F])[\\s\\S]+$"
        },
        "query_variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/publicText"
          }
        },
        "preferred_source_tiers": {
          "type": "array",
          "prefixItems": [
            {"const": "A"},
            {"const": "B"},
            {"const": "C"}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "max_candidates": {
          "type": "integer",
          "const": 10
        },
        "freshness_rule": {
          "type": "string",
          "enum": [
            "verify_exact_current_year_availability",
            "query_exact_expected_available_year"
          ]
        },
        "required_extraction_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeField"
          }
        },
        "availability_expectation": {
          "type": "string",
          "enum": [
            "current_year_availability_must_be_checked",
            "expected_available"
          ]
        },
        "max_network_retries": {"type": "integer", "const": 1},
        "stop_conditions": {
          "type": "array",
          "prefixItems": [{"const": "accepted"}, {"const": "candidate-cap"}, {"const": "variants-exhausted"}, {"const": "unavailable"}],
          "items": false, "minItems": 4, "maxItems": 4
        },
        "unavailable_reasons": {
          "type": "array",
          "prefixItems": [{"const": "current_year_not_published"}, {"const": "source_threshold_not_met"}, {"const": "source_conflict"}, {"const": "network_unavailable"}, {"const": "capability_unavailable"}, {"const": "newer_comparable_year_accepted"}],
          "items": false, "minItems": 6, "maxItems": 6
        },
        "source_policy_id": {"const": "pathway-atlas-source-policy"},
        "source_policy_version": {"const": "1.0"}
      }
    }
  }
}
