{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/shengxue-skill/schemas/query-plan.schema.json",
  "title": "Deterministic research query plan",
  "$comment": "Structure is validated here; task ID, context, explicit-year, and availability semantics also require the declared pure runtime validator.",
  "x-semantic-validator": {
    "locator": "scripts.query_plan.validate_query_plan_payload",
    "flat_locator": "query_plan.validate_query_plan_payload",
    "checks": [
      "task_id_digest",
      "task_context",
      "explicit_three_year_window",
      "availability_expectation"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "province",
    "exam_year",
    "subject_group",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "province": {
      "$ref": "#/$defs/publicText"
    },
    "exam_year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100
    },
    "subject_group": {
      "$ref": "#/$defs/publicText"
    },
    "tasks": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/queryTask"
      }
    }
  },
  "$defs": {
    "publicText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001F\\u007F])[\\s\\S]+$"
    },
    "safeField": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "queryTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "kind",
        "province",
        "year",
        "subject_group",
        "query_variants",
        "preferred_source_tiers",
        "max_candidates",
        "freshness_rule",
        "required_extraction_fields",
        "availability_expectation"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "score_table",
            "admission",
            "joy_report",
            "pathway_policy"
          ]
        },
        "province": {
          "$ref": "#/$defs/publicText"
        },
        "year": {
          "type": "integer",
          "minimum": 1998,
          "maximum": 2100
        },
        "subject_group": {
          "$ref": "#/$defs/publicText"
        },
        "query_variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/publicText"
          }
        },
        "preferred_source_tiers": {
          "type": "array",
          "prefixItems": [
            {"const": "A"},
            {"const": "B"},
            {"const": "C"}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "max_candidates": {
          "type": "integer",
          "const": 10
        },
        "freshness_rule": {
          "type": "string",
          "enum": [
            "query_exact_year_and_record_unpublished",
            "query_exact_historical_year_no_silent_substitution"
          ]
        },
        "required_extraction_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeField"
          }
        },
        "availability_expectation": {
          "type": "string",
          "enum": [
            "current_year_not_yet_expected",
            "explicit_older_year"
          ]
        }
      }
    }
  }
}
