{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "New-Gaokao Province Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verified_at",
    "coverage_note",
    "mode_authority_urls",
    "provinces"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "verified_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "coverage_note": {
      "type": "string",
      "minLength": 1
    },
    "mode_authority_urls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[^/?#\\s]+(?:/[^?#\\s]*)?$"
      }
    },
    "provinces": {
      "type": "array",
      "minItems": 29,
      "maxItems": 29,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "province",
          "aliases",
          "mode",
          "authority_name",
          "official_roots",
          "mode_source_url",
          "verified_at",
          "notes"
        ],
        "properties": {
          "province": {
            "type": "string",
            "enum": [
              "北京",
              "天津",
              "上海",
              "浙江",
              "山东",
              "海南",
              "河北",
              "山西",
              "内蒙古",
              "辽宁",
              "吉林",
              "黑龙江",
              "江苏",
              "安徽",
              "福建",
              "江西",
              "河南",
              "湖北",
              "湖南",
              "广东",
              "广西",
              "重庆",
              "四川",
              "贵州",
              "云南",
              "陕西",
              "甘肃",
              "青海",
              "宁夏"
            ]
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "3+3",
              "3+1+2"
            ]
          },
          "authority_name": {
            "type": "string",
            "minLength": 1
          },
          "official_roots": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^https://[^/?#\\s]+(?:/[^?#\\s]*)?$"
            }
          },
          "mode_source_url": {
            "type": "string",
            "pattern": "^https://[^/?#\\s]+(?:/[^?#\\s]*)?$"
          },
          "verified_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
