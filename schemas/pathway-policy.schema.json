{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shengxue-skill.example/schemas/pathway-policy.schema.json",
  "title": "Evidence-backed pathway policy",
  "$comment": "This Schema validates one policy record's JSON structure. Every record and evaluation must also pass the declared runtime semantic validators.",
  "x-semantic-validator": {
    "policy": "scripts.path_recommend.PathwayPolicy",
    "evaluate": "scripts.path_recommend.evaluate_pathways",
    "checks": [
      "source_threshold_by_status",
      "current_year_validity",
      "critical_constraint_completeness",
      "profile_policy_match",
      "promise_language_gate"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "pathway_type",
    "title",
    "institution",
    "province",
    "subject_mode",
    "valid_year",
    "eligibility_requirements",
    "disqualifying_facts",
    "service_employment_obligations",
    "penalty_exit_rules",
    "fees_and_subsidies",
    "policy_source_ids",
    "evidence_status",
    "calculation_basis"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "pathway_type": {
      "type": "string",
      "enum": [
        "strong_foundation",
        "comprehensive_evaluation",
        "special_program",
        "public_funded_or_directed",
        "hong_kong_macao",
        "other"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "institution": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "province": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "subject_mode": {
      "type": "string",
      "enum": ["3+1+2", "3+3"]
    },
    "valid_year": {
      "type": ["integer", "null"],
      "minimum": 2000,
      "maximum": 2100
    },
    "eligibility_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$"
      }
    },
    "disqualifying_facts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$"
      }
    },
    "service_employment_obligations": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "penalty_exit_rules": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "fees_and_subsidies": {
      "type": ["string", "null"],
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "policy_source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "official",
        "corroborated",
        "reference",
        "inferred",
        "conflict",
        "missing",
        "masked",
        "partial"
      ]
    },
    "calculation_basis": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    }
  }
}
